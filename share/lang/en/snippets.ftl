# Snippets's own words, in English. Keys start with snippets-.

# Under the form when the person tries to leave a snippet with unsaved changes.
snippets-unsaved = You have unsaved changes. Save them, or press Cancel to discard them.

# The hint at the foot of the window.
snippets-foot-hint = Allow Snippets to type for you when Trindle asks. Then type a trigger such as :tm in any program. You can also find a snippet and copy it.

# Red words when the snippet being edited vanished from its file.
snippets-removed-from-file = This snippet was removed from its file. Your changes are still here. Press Save to add it back.

# Said once at start when unsaved words were restored.
snippets-words-back = Snippets has restored the text you hadn't saved last time.

# Said when Copy is pressed on a snippet with variables.
snippets-copy-needs-plain = This snippet uses variables, forms or scripts, so it only works when you type its trigger. There's no plain text to copy.

# Said when Copy is pressed with an empty replacement.
snippets-copy-empty = The replacement is empty, so there's nothing to copy.

# Said after an import was cancelled.
snippets-imported-nothing = Nothing was imported.

# Said after the snippet files were read again.
snippets-read-again = Snippets has reloaded the snippet files.

# In the list when there are no snippets.
snippets-list-empty = No snippets yet.

# In the list when a search finds nothing.
snippets-list-no-match = Nothing matches that search.

# Hint in the search box.
snippets-search-hint = Search triggers and text

# Tooltip of the plus button.
snippets-add-hint = Add snippet

# Tooltip of the button that cancels an import of files that would run commands.
snippets-import-nothing = Cancel

# Button that goes ahead with an import.
snippets-bring-in = Import

# Tooltip of the import button.
snippets-import-hint = Import snippets from a file

# Tooltip of the export button.
snippets-export-hint = Export all snippets to a file

# Tooltip of the reload button.
snippets-reload-hint = Reload snippet files

# Heading of the form for a new snippet.
snippets-heading-new = New snippet

# Heading of the form for a snippet that cannot be edited.
snippets-heading-snippet = Snippet

# Badge beside the heading of a read-only snippet.
snippets-badge-package = Read-only: from an installed package or linked file

# Badge beside the heading of a snippet Snippets only shows.
snippets-badge-readonly = Read-only

# Heading of the form for a snippet being edited.
snippets-heading-edit = Edit snippet

# Shown in the form when no snippet is picked.
snippets-pick-or-add = Choose a snippet to edit, or add a new one.

# Button that undoes a delete.
snippets-put-back = Restore

# Label of the triggers box.
snippets-triggers = Triggers

# Under the triggers box.
snippets-triggers-about = Type a trigger to insert the snippet. Separate triggers with commas.

# Label above a snippet that is shown as written in its file.
snippets-raw-label = Snippet as written in its file

# Label of the replacement box.
snippets-replacement = Replacement

# Tooltip of the copy button.
snippets-copy-replacement = Copy replacement text

# Label of a switch.
snippets-whole-words = Whole words only

# Tooltip of the whole words switch.
snippets-whole-words-hint = Expand only when the trigger is a whole word

# Label of a switch.
snippets-match-case = Match capital letters

# Tooltip of the match case switch.
snippets-match-case-hint = Type the trigger in capitals to get the replacement in capitals

# Tooltip of the delete button.
snippets-delete-hint = Delete this snippet from its file

# Tooltip of the button that drops unsaved changes.
snippets-cancel-hint = Discard changes

# Button that saves the snippet.
snippets-save = Save

# Label of the box for a new snippet file's name.
snippets-new-file = New file

# Tooltip of the button that drops a new file's name.
snippets-no-new-file = Cancel

# Button that makes the new file.
snippets-make = Create file

# Under the box for a new file's name.
snippets-file-name-about = Use letters, numbers, spaces, dashes or underscores.

# Tooltip of the list of files.
snippets-file-it-goes-in = Snippet file

# Label for the file a snippet is in.
snippets-file = File

# Tooltip of the button that offers a new file.
snippets-make-new-file-hint = Put it in a new snippet file

# Item of the replacement box's menu.
snippets-cut = Cut

# Item of the replacement box's menu.
snippets-copy = Copy

# Item of the replacement box's menu.
snippets-paste = Paste

# Item of the replacement box's menu.
snippets-select-all = Select all

# Small mark on a snippet in the list that uses variables or more.
snippets-mark-advanced = advanced

# Small mark on a snippet in the list that came from a package.
snippets-mark-package = package

# Shown in the list for a snippet with no trigger.
snippets-no-trigger = (no trigger)

# Said after a snippet was added.
snippets-snippet-added = Snippet added.

# Said after a snippet was saved.
snippets-snippet-saved = Snippet saved.

# Said after delete was pressed once.
snippets-delete-again = Press Delete again to remove this snippet, or Cancel to keep it.

# Said after a snippet was deleted.
snippets-snippet-deleted = Snippet deleted. Press Restore to undo.

# Said after a deleted snippet was put back.
snippets-snippet-put-back = Snippet restored.

# Red words when there is no way to open the file chooser.
snippets-cannot-choose = Snippets can't open a file chooser here.

# Name of the kind of file the import chooser offers.
snippets-choose-filter-import = Snippet files and archives

# Title of the import chooser.
snippets-choose-import = Import snippets

# Name of the kind of file the export chooser offers.
snippets-choose-filter-export = Snippet archive

# Title of the export chooser.
snippets-choose-export = Export snippets

# Red words when the file chooser would not open.
snippets-chooser-failed = Snippets couldn't open the file chooser.

# Said after an export.
snippets-exported = Snippets exported.

# Said while an import file is read.
snippets-reading-file = Reading the file.

# Said after the replacement was copied.
snippets-copied = Copied.

# Said when the snippet folder cannot be watched.
snippets-not-watched = Snippets may not notice changes other programs make to the snippet files. Press Reload to see them.

# Headline of the ring icon's menu.
snippets-expansion-on = Typing expansion is on

# Headline of the ring icon's menu.
snippets-expansion-off = Typing expansion is off

# Under the replacement when it cannot expand.
snippets-wont-line-break = This snippet won't expand as you type, because the replacement has a line break or tab. You can still copy it.

# Under the replacement when it cannot expand.
snippets-wont-variable = This snippet won't expand as you type, because the replacement contains a variable.

# Under the replacement when it cannot expand.
snippets-wont-long = This snippet won't expand as you type, because the replacement is too long.

# Under the replacement when it cannot expand.
snippets-wont-trigger = This snippet won't expand as you type, because its triggers need to be 3 to 32 characters long, with no spaces.

# Problem when a file cannot be written.
snippets-not-writable = Snippets can't save to that file.

# Problem for a file from a package.
snippets-from-package = This came from an installed package, so it is read-only here.

# Problem for a file that is a link.
snippets-is-link = This file is a link to a file stored somewhere else, so you can't change it here.

# Problem when a snippet is not fully understood.
snippets-no-overwrite = Snippets can't save this snippet, because it can't show all of it.

# Problem for a bad new file name.
snippets-file-name-rule = Use letters, numbers, spaces, dashes or underscores.

# Problem for a bad new file name.
snippets-name-unusable = You can't use that name. Try a different one.

# Problem for a new file name that exists.
snippets-name-taken = There is already a file with that name.

# Problem when an export fails.
snippets-too-many-to-pack = Snippets couldn't export your snippets. There may be too many for one archive.

# Problem when an imported file cannot be named.
snippets-no-free-name = Snippets couldn't find an unused name for an imported file.

# Problem for a file that is too large.
snippets-too-large = This file is too large to be a snippet file.

# Problem for a file that is not UTF-8.
snippets-not-utf8 = This file isn't saved as UTF-8 text.

# Problem when a snippet was removed from its file.
snippets-snippet-gone = That snippet no longer exists. Press Reload.

# Problem when a snippet changed in its file.
snippets-snippet-changed = That snippet has changed in its file since you opened it. Press Cancel to load it again.

# Problem when a safe edit was not possible.
snippets-unsafe-change = Snippets couldn't save your changes without changing other snippets, so it hasn't saved anything.

# Problem under the triggers box.
snippets-need-trigger = Add at least one trigger.

# Problem under the triggers box.
snippets-trigger-spaces = A trigger can't contain spaces. Try something like :addr.

# Problem under the triggers box.
snippets-trigger-long = That trigger is too long.

# Problem under the replacement.
snippets-need-replace = Add the replacement text.

# Problem under the replacement.
snippets-replace-long = The replacement is too long for a snippet.

# Said for a snippet that is shown but not edited.
snippets-odd-shape = Snippets can't edit this snippet because of how it's written.

# Said for a snippet that is shown but not edited.
snippets-odd-written = Snippets can show this snippet but can't edit it.

# Said for a snippet that is shown but not edited.
snippets-odd-no-text = This snippet has no plain replacement text.

# Problem for an import file that is too large.
snippets-import-too-large = That file is too large to be a snippet file.

# Problem for an import file of the wrong kind.
snippets-import-choose = Choose a .yml, .yaml or .tar.gz file.

# Problem for an import that holds no snippets.
snippets-import-none = Snippets didn't find any snippet files in that file.

# Problem for an archive.
snippets-archive-bad = That archive is too large or damaged.

# Problem for an archive.
snippets-archive-unopened = Snippets couldn't open that archive.

# Problem for an archive.
snippets-archive-much = The files in that archive add up to too much data.

# Problem for an archive.
snippets-archive-many = That archive contains too many files.

# Why a snippet is shown but not edited.
snippets-y-anchor = It uses an anchor, an alias or a tag.

# Why a snippet is shown but not edited.
snippets-y-flow = Its values are written on one line.

# Why a snippet is shown but not edited.
snippets-y-flow-list = It has a list spread over several lines.

# Why a snippet is shown but not edited.
snippets-y-deep = Its values are nested too deeply for Snippets to edit.

# Why a snippet is shown but not edited.
snippets-y-list = It has a list Snippets can't read.

# Why a snippet is shown but not edited.
snippets-y-after-quote = There is text after the closing quote.

# Why a snippet is shown but not edited.
snippets-y-escape = It has an escape code Snippets doesn't recognise.

# Why a snippet is shown but not edited.
snippets-y-open-quote = A closing quote is missing.

# Why a snippet is shown but not edited.
snippets-y-colon = It has a colon that YAML reads as the start of a name.

# Why a snippet is shown but not edited.
snippets-y-comment = There's a comment in the middle of its text.

# Why a snippet is shown but not edited.
snippets-y-block-header = Snippets can't edit this block header.

# Why a snippet is shown but not edited.
snippets-y-block-indent = Snippets doesn't support the indentation in this block.

# Why a file is left alone.
snippets-y-first-indent = The first line is indented. Snippets can't edit files with this layout.

# Why a file is left alone.
snippets-y-not-named = A snippet file needs named values, but this file doesn't have them.

# Why a file is left alone.
snippets-y-matches-twice = The file has two matches sections.

# Why a file is left alone.
snippets-y-bom = The file starts with a byte order mark. Snippets can't edit files with this mark.

# Why a file is left alone.
snippets-y-tabs = This file uses tabs to indent text, which YAML doesn't allow.

# Why a file is left alone.
snippets-y-directive = The file starts with a YAML directive. Snippets can't edit files with directives.

# Why a file is left alone.
snippets-y-documents = The file contains more than one document.

# Why a file is left alone.
snippets-y-one-line = The snippets are written on one line. Snippets can't edit this layout.

# Why a file is left alone.
snippets-y-matches-not-list = The matches entry must be a list.

# Why a snippet is shown but not edited.
snippets-y-empty = It is empty.

# Why a snippet is shown but not edited.
snippets-y-item-indent = Snippets doesn't support the indentation of these values.

# Why a snippet is shown but not edited.
snippets-y-item-not-named = This entry doesn't have named values.

# Why a snippet is shown but not edited.
snippets-y-item-twice = This entry has the same name twice.

# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
        [one] 1 snippet
       *[other] { $count } snippets
    }
# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
        [one] { $shown } of 1 snippet
       *[other] { $shown } of { $all } snippets
    }
# The version at the foot of the window. $version is its number.
snippets-version = Snippets { $version }
# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = Snippets couldn't update typing expansion: { $why }
# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = Snippets skipped { $file }. { $why }
# Asks whether to import files that would run commands. $files names them.
snippets-risky = { $files } would run commands on this computer if used with Espanso. Import them?
# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = +{ $count } more
# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
        [one] Imported 1 file.
       *[other] Imported { $count } files.
    }
# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = Snippets couldn't create { $path }: { $why }
# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = Snippets couldn't read { $file }. { $why }
# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = Nothing was saved, because Snippets couldn't make a backup copy of the file: { $why }
# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = Snippets couldn't write { $path }: { $why }
# Problem when a file could not be read. $why says why.
snippets-read-failed = Snippets couldn't read the file: { $why }
# Problem when a file could not be opened. $why says why.
snippets-open-failed = Snippets couldn't open the file: { $why }
# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = Snippets couldn't save the snippet: { $why }
# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = Snippets can show this snippet but can't edit it, because it uses { $names }.
# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = { $name } is too large to import as a snippet file.
# Why a file is left alone. $line is the line number.
snippets-y-line-indent = Snippets doesn't support the indentation on line { $line }.
