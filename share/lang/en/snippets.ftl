# Snippets's own words, in English. Keys start with snippets-.

# Under the form when the person tries to leave a snippet with unsaved changes.
snippets-unsaved = You have changes that are not saved. Save them, or press Cancel to leave them.

# The hint at the foot of the window.
snippets-foot-hint = Type a trigger such as :tm in any program to expand it, once Snippets is allowed to expand your short codes in its permissions. Or find a snippet and copy it.

# Red words when the snippet being edited vanished from its file.
snippets-removed-from-file = That snippet was removed from its file. Your changes are kept; Save adds it again.

# Said once at start when unsaved words were restored.
snippets-words-back = The words you had not saved last time are back.

# Said when Copy is pressed on a snippet with variables.
snippets-copy-needs-plain = This snippet uses variables, forms or scripts, which only work where typing expands. There is no plain text to copy.

# Said when Copy is pressed with an empty replacement.
snippets-copy-empty = There is nothing in the replacement to copy.

# Said after an import was cancelled.
snippets-imported-nothing = Nothing was imported.

# Said after the snippet files were read again.
snippets-read-again = Read again.

# In the list when there are no snippets.
snippets-list-empty = No snippets yet. Press the plus to write one.

# In the list when a search finds nothing.
snippets-list-no-match = Nothing matches that search.

# Hint in the search box.
snippets-search-hint = Search triggers and text

# Tooltip of the plus button.
snippets-add-hint = Add a new snippet

# Tooltip of the button that cancels an import of files that would run commands.
snippets-import-nothing = Import nothing

# Button that goes ahead with an import.
snippets-bring-in = Bring in

# Tooltip of the import button.
snippets-import-hint = Import snippets from a file

# Tooltip of the export button.
snippets-export-hint = Export all snippets to a file

# Tooltip of the reload button.
snippets-reload-hint = Read the snippet files again

# Heading of the form for a new snippet.
snippets-heading-new = New snippet

# Heading of the form for a snippet that cannot be edited.
snippets-heading-snippet = Snippet

# Badge beside the heading of a read-only snippet.
snippets-badge-package = From a package or a link, so read-only

# Badge beside the heading of a snippet Snippets only shows.
snippets-badge-readonly = Read-only here

# Heading of the form for a snippet being edited.
snippets-heading-edit = Edit snippet

# Shown in the form when no snippet is picked.
snippets-pick-or-add = Pick a snippet to change it, or add a new one.

# Button that undoes a delete.
snippets-put-back = Put back

# Label of the triggers box.
snippets-triggers = Triggers

# Under the triggers box.
snippets-triggers-about = What you type to set it off. Separate several with a comma.

# Label above a snippet that is shown as written in its file.
snippets-raw-label = This snippet, as it is in its file

# Label of the replacement box.
snippets-replacement = Replacement

# Tooltip of the copy button.
snippets-copy-replacement = Copy the replacement, to paste anywhere

# Label of a switch.
snippets-whole-words = Whole words only

# Tooltip of the whole words switch.
snippets-whole-words-hint = Only when the trigger stands as a whole word

# Label of a switch.
snippets-match-case = Match the case I type

# Tooltip of the match case switch.
snippets-match-case-hint = Typing the trigger in capitals gives capitals

# Tooltip of the delete button.
snippets-delete-hint = Delete this snippet from its file

# Tooltip of the button that drops unsaved changes.
snippets-cancel-hint = Put back as it was

# Button that saves the snippet.
snippets-save = Save

# Label of the box for a new snippet file's name.
snippets-new-file = New file

# Tooltip of the button that drops a new file's name.
snippets-no-new-file = Do not make a new file

# Button that makes the new file.
snippets-make = Make

# Under the box for a new file's name.
snippets-file-name-about = Letters, numbers, spaces, dashes or underscores.

# Tooltip of the list of files.
snippets-file-it-goes-in = The file it goes in

# Label for the file a snippet is in.
snippets-file = File

# Tooltip of the button that offers a new file.
snippets-make-new-file-hint = Make a new file for it

# Item of the replacement box's menu.
snippets-cut = Cut

# Item of the replacement box's menu.
snippets-copy = Copy

# Item of the replacement box's menu.
snippets-paste = Paste

# Item of the replacement box's menu.
snippets-select-all = Select all

# Small mark on a snippet in the list that uses variables or more.
snippets-mark-advanced = advanced

# Small mark on a snippet in the list that came from a package.
snippets-mark-package = package

# Shown in the list for a snippet with no trigger.
snippets-no-trigger = (no trigger)

# Said after a snippet was added.
snippets-snippet-added = Snippet added.

# Said after a snippet was saved.
snippets-snippet-saved = Snippet saved.

# Said after delete was pressed once.
snippets-delete-again = Press delete again to remove this snippet. Cancel keeps it.

# Said after a snippet was deleted.
snippets-snippet-deleted = Snippet deleted. Press put back to undo.

# Said after a deleted snippet was put back.
snippets-snippet-put-back = Snippet put back.

# Red words when there is no way to open the file chooser.
snippets-cannot-choose = Files cannot be chosen here.

# Name of the kind of file the import chooser offers.
snippets-choose-filter-import = Snippet files and archives

# Title of the import chooser.
snippets-choose-import = Import snippets

# Name of the kind of file the export chooser offers.
snippets-choose-filter-export = Snippet archive

# Title of the export chooser.
snippets-choose-export = Export snippets

# Red words when the file chooser would not open.
snippets-chooser-failed = The window for choosing files could not be opened.

# Said after an export.
snippets-exported = Snippets exported.

# Said while an import file is read.
snippets-reading-file = Reading the file.

# Said after the replacement was copied.
snippets-copied = Copied. Paste it where you need it.

# Said when the snippet folder cannot be watched.
snippets-not-watched = Changes made to the snippet files by other programs may not be noticed. Press the reload button to read them.

# Headline of the ring icon's menu.
snippets-expansion-on = Typing expansion is on

# Headline of the ring icon's menu.
snippets-expansion-off = Typing expansion is off

# Under the replacement when it cannot expand.
snippets-wont-line-break = It will not expand as you type, because the replacement has a line break or tab. You can still copy it.

# Under the replacement when it cannot expand.
snippets-wont-variable = It will not expand as you type, because the replacement holds a variable.

# Under the replacement when it cannot expand.
snippets-wont-long = It will not expand as you type, because the replacement is too long.

# Under the replacement when it cannot expand.
snippets-wont-trigger = It will not expand as you type, because a trigger needs 3 to 32 characters with no spaces.

# Problem when a file cannot be written.
snippets-not-writable = That is not a file Snippets can write to.

# Problem for a file from a package.
snippets-from-package = This came from an installed package, so it is read-only here.

# Problem for a file that is a link.
snippets-is-link = This file is a link to somewhere else, so it is read-only here.

# Problem when a snippet is not fully understood.
snippets-no-overwrite = Snippets does not write over a snippet it cannot show in full.

# Problem for a bad new file name.
snippets-file-name-rule = Use letters, numbers, spaces, dashes or underscores.

# Problem for a bad new file name.
snippets-name-unusable = That name cannot be used.

# Problem for a new file name that exists.
snippets-name-taken = There is already a file with that name.

# Problem when an export fails.
snippets-too-many-to-pack = The snippets could not be packed, or they are too many to hold in one archive.

# Problem when an imported file cannot be named.
snippets-no-free-name = No free name was left for an imported file.

# Problem for a file that is too large.
snippets-too-large = It is too large to be snippets.

# Problem for a file that is not UTF-8.
snippets-not-utf8 = It is not written in UTF-8.

# Problem when a snippet was removed from its file.
snippets-snippet-gone = That snippet is not there any more. Reload.

# Problem when a snippet changed in its file.
snippets-snippet-changed = That snippet has changed in its file since it was shown. Press Cancel to read it again.

# Problem when a safe edit was not possible.
snippets-unsafe-change = Snippets could not save this without changing other snippets, so nothing was written.

# Problem under the triggers box.
snippets-need-trigger = Give it at least one trigger.

# Problem under the triggers box.
snippets-trigger-spaces = A trigger cannot hold spaces. Try :addr.

# Problem under the triggers box.
snippets-trigger-long = That trigger is too long.

# Problem under the replacement.
snippets-need-replace = Give it something to turn into.

# Problem under the replacement.
snippets-replace-long = That is too long for a snippet.

# Said for a snippet that is shown but not edited.
snippets-odd-shape = This snippet is not in a shape Snippets can edit.

# Said for a snippet that is shown but not edited.
snippets-odd-written = This snippet is written in a way Snippets shows but does not edit.

# Said for a snippet that is shown but not edited.
snippets-odd-no-text = This snippet has no plain text to turn into.

# Problem for an import file that is too large.
snippets-import-too-large = That file is too large to be snippets.

# Problem for an import file of the wrong kind.
snippets-import-choose = Choose a .yml, .yaml or .tar.gz file.

# Problem for an import that holds no snippets.
snippets-import-none = No snippet files were found in it.

# Problem for an archive.
snippets-archive-bad = That archive is too large, or damaged.

# Problem for an archive.
snippets-archive-unopened = That archive could not be opened.

# Problem for an archive.
snippets-archive-much = That archive holds too much to be snippets.

# Problem for an archive.
snippets-archive-many = That archive holds too many files.

# Why a snippet is shown but not edited.
snippets-y-anchor = It uses an anchor, an alias or a tag.

# Why a snippet is shown but not edited.
snippets-y-flow = It is a set of values on one line.

# Why a snippet is shown but not edited.
snippets-y-flow-list = A list on more than one line.

# Why a snippet is shown but not edited.
snippets-y-deep = Its values are nested deeper than Snippets edits.

# Why a snippet is shown but not edited.
snippets-y-list = A list Snippets cannot follow.

# Why a snippet is shown but not edited.
snippets-y-after-quote = Words follow its closing quote.

# Why a snippet is shown but not edited.
snippets-y-escape = It has an escape Snippets does not know.

# Why a snippet is shown but not edited.
snippets-y-open-quote = Its quote is never closed.

# Why a snippet is shown but not edited.
snippets-y-colon = It holds a colon that YAML reads as a name.

# Why a snippet is shown but not edited.
snippets-y-comment = A comment breaks its words.

# Why a snippet is shown but not edited.
snippets-y-block-header = Its block has a header Snippets does not edit.

# Why a snippet is shown but not edited.
snippets-y-block-indent = Its block is indented in a way Snippets cannot follow.

# Why a file is left alone.
snippets-y-first-indent = It is indented from its first line, which Snippets does not edit.

# Why a file is left alone.
snippets-y-not-named = It is not a set of named values, as a snippet file is.

# Why a file is left alone.
snippets-y-matches-twice = It names matches twice.

# Why a file is left alone.
snippets-y-bom = It starts with a byte order mark, which Snippets does not edit.

# Why a file is left alone.
snippets-y-tabs = It is indented with tabs, which YAML does not allow.

# Why a file is left alone.
snippets-y-directive = It starts with a YAML directive, which Snippets does not edit.

# Why a file is left alone.
snippets-y-documents = It holds more than one document.

# Why a file is left alone.
snippets-y-one-line = Its snippets are written on one line, which Snippets does not edit.

# Why a file is left alone.
snippets-y-matches-not-list = Its matches are not a list.

# Why a snippet is shown but not edited.
snippets-y-empty = It is empty.

# Why a snippet is shown but not edited.
snippets-y-item-indent = Its values are indented in a way Snippets cannot follow.

# Why a snippet is shown but not edited.
snippets-y-item-not-named = It is not a set of named values.

# Why a snippet is shown but not edited.
snippets-y-item-twice = It names the same value twice.

# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
        [one] 1 snippet
       *[other] { $count } snippets
    }
# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
        [one] { $shown } of 1 snippet
       *[other] { $shown } of { $all } snippets
    }
# The version at the foot of the window. $version is its number.
snippets-version = Snippets { $version }
# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = Typing expansion could not be brought up to date: { $why }.
# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = { $file } is left alone. { $why }
# Asks whether to import files that would run commands. $files names them.
snippets-risky = { $files } would run commands on this computer if used with Espanso. Bring them in?
# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = +{ $count } more
# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
        [one] Imported 1 file.
       *[other] Imported { $count } files.
    }
# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = { $path } could not be made: { $why }
# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = { $file } could not be read. { $why }
# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = Nothing was saved, because a copy of the file could not be kept: { $why }
# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = { $path } could not be written: { $why }
# Problem when a file could not be read. $why says why.
snippets-read-failed = It could not be read: { $why }
# Problem when a file could not be opened. $why says why.
snippets-open-failed = It could not be opened: { $why }
# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = It could not be saved: { $why }
# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = This snippet uses { $names }, which Snippets shows but does not edit.
# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = { $name } is too large to be snippets.
# Why a file is left alone. $line is the line number.
snippets-y-line-indent = Line { $line } is indented in a way Snippets cannot follow.
